{
  "projectType": "sdk-library",
  "projectName": "Swappit",
  "projectDescription": "A lightweight JavaScript library for declarative, partial HTML content updates without full page reloads, using custom data attributes instead of a full SPA framework.",
  "theme": "luma",
  "primaryColor": "#fcc72c",
  "lightColor": "#f5d8d5",
  "darkColor": "#1c3c44",
